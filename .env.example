# Copy to .env.dev.local for local development (or let scripts/start-local.sh generate it for
# you on first run) — never commit a filled-in version of this. See docs/architecture.md for
# what each variable means and README.md for the full local-dev walkthrough.

# --- Database ---
# Matches docker-compose.dev.yml's local MariaDB service. DB_ROOT_PASSWORD is only used to
# initialize that container; the app itself only ever uses DB_USER/DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hibiscus
DB_USER=hibiscus
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Backend server ---
PORT=3000

# --- Forward-auth contract (see docs/architecture.md#authentication) ---
# Name of the header your reverse proxy (Authentik, Keycloak/oauth2-proxy, Traefik forward-auth,
# ...) injects with the authenticated user's identity.
AUTH_HEADER_USER=X-Forwarded-User
# Comma-separated usernames/emails allowed to use the app — must match what your proxy asserts.
ALLOWED_USERS=you@example.com
# Pre-shared secret your proxy must also send, in the fixed X-Internal-Auth-Secret header.
# Generate a long random value, e.g.: openssl rand -hex 32
INTERNAL_PROXY_SECRET=generate-a-long-random-value
